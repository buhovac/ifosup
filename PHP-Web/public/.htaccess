ErrorDocument 401 /vues/ma-page-401-perso.php
ErrorDocument 403 /vues/ma-page-403-perso.php
ErrorDocument 404 /vues/ma-page-404-perso.php
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{THE_REQUEST} \s/+(.+)\.php[?\s]
    RewriteRule ^ %1 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ $1.php [L]
</IfModule>
